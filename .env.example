# Example only. Generate a new environment with `python -m lab bootstrap plan`.
# This file cannot access the previous workshop environment.
# Sign in interactively; never put keys, passwords, or access tokens here.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000001
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000002
EXPECTED_AZURE_USER=participant@example.invalid
AZURE_LOCATION=northcentralus
AZURE_RESOURCE_GROUP=rg-foundry-eval-v11-example
AZURE_AI_ACCOUNT_NAME=foundry-eval-v11-example
AZURE_AI_PROJECT_NAME=contoso-eval
AZURE_AI_PROJECT_ENDPOINT=https://foundry-eval-v11-example.services.ai.azure.com/api/projects/contoso-eval
AZURE_OPENAI_ENDPOINT=https://foundry-eval-v11-example.openai.azure.com
AZURE_SEARCH_SERVICE=srch-foundry-eval-v11-example
AZURE_SEARCH_ENDPOINT=https://srch-foundry-eval-v11-example.search.windows.net
MODEL_DEPLOYMENT=workshop-chat
JUDGE_DEPLOYMENT=workshop-judge
OPTIMIZER_DEPLOYMENT=workshop-optimizer
# The IQ query planner is separate from the agent's answer model.
IQ_PLANNER_DEPLOYMENT=workshop-optimizer
EMBEDDING_DEPLOYMENT=workshop-embedding
# Unique participant namespace: lowercase letters, digits and hyphens.
LAB_PREFIX=llab-example
# Set only after a real, approved training job has produced a deployment.
TUNED_MODEL_DEPLOYMENT=
# Set by successful bootstrap, not by copying an old environment.
BOOTSTRAP_CONFIG=
