{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foundry-eval-v11:bootstrap-plan:1",
  "title": "Private, pinned bootstrap plan",
  "description": "Generated by lab.bootstrap.plan. Never change fields after approval: scope_sha256 covers all fields except itself.",
  "type": "object",
  "required": [
    "schema_version", "instance_id", "created_at", "environment", "environment_dir",
    "subscription_id", "tenant_id", "expected_user", "location", "retention_days",
    "models", "deployment_name", "template_sha256", "names", "scope_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,23}$"},
    "environment_dir": {"type": "string", "minLength": 1},
    "subscription_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "expected_user": {"type": "string", "format": "email"},
    "location": {"const": "northcentralus"},
    "retention_days": {"type": "integer", "minimum": 30, "maximum": 730},
    "models": {
      "$ref": "urn:foundry-eval-v11:bootstrap-approval:1#/properties/models"
    },
    "deployment_name": {"type": "string", "pattern": "^lab-bootstrap-[a-f0-9]{8}$"},
    "template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "names": {
      "type": "object",
      "required": ["resource_group", "account", "project", "search", "workspace", "insights"],
      "properties": {
        "resource_group": {"type": "string", "pattern": "^rg-foundry-eval-v11-[0-9]{8}-[a-f0-9]{6,12}$"},
        "account": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,59}$"},
        "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,59}$"},
        "search": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,59}$"},
        "workspace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,59}$"},
        "insights": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,59}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
